# Vorlage: vm/install-remote.sh setzt Domain und Quellcode-Link ein, hängt je Gruppe eine Seite an
# (<gruppe>.__DOMAIN__, eigenes Backend, eigener Login plus leitung) und schreibt deploy/Caddyfile.

(sicherheit) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	log {
		output stdout
		format json
	}
}

# Eine Gruppen-Instanz. Aufruf: import instanz <backend-dienst>
(instanz) {
	encode zstd gzip

	# AGPL-3.0: geänderter Quellcode für alle Nutzenden ohne Login erreichbar
	redir /quellcode __SOURCE_URL__

	# Löschen nur per SSH durch die Leitung
	@delete method DELETE
	respond @delete "Löschen ist im Workshop gesperrt" 403

	handle /api/* {
		reverse_proxy {args[0]}:5001
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	import sicherheit
}

# Infoseite ohne Login: Links zu allen Gruppen, Ablauf, Spielregeln (keine Passwörter)
__DOMAIN__ {
	encode zstd gzip
	redir /quellcode __SOURCE_URL__

	# Unterlagen für die Leitung (Zugangskarten mit Passwörtern), nur mit Login.
	# Die Dateien liegen nur auf der VM in deploy/info/leitung/, nie im Repo.
	@leitung path /leitung/*
	basic_auth @leitung {
		leitung __LEITUNG_HASH__
	}

	root * /srv-info
	file_server
	import sicherheit
}
